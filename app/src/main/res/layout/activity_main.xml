<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F6"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- App Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💸 บันทึกรายจ่าย"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#2C3E50"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="จดง่ายๆ สบายกระเป๋า"
            android:textSize="14sp"
            android:textColor="#7F8C8D"
            android:layout_marginBottom="24dp" />

        <!-- Simple Total Today Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ยอดใช้จ่ายวันนี้"
                    android:textSize="14sp"
                    android:textColor="#7F8C8D" />

                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="฿0.00"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#E74C3C"
                    android:layout_marginTop="6dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Input Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Amount -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="จำนวนเงิน (บาท)"
                    android:textSize="14sp"
                    android:textColor="#34495E"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etAmount"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_edit_text"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:inputType="numberDecimal"
                    android:hint="0.00"
                    android:textColor="#2C3E50"
                    android:textColorHint="#BDC3C7"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp" />

                <!-- Note -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="รายละเอียด / โน้ต"
                    android:textSize="14sp"
                    android:textColor="#34495E"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etNote"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_edit_text"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:inputType="text"
                    android:hint="เช่น ค่าข้าว, ค่ากาแฟ"
                    android:textColor="#2C3E50"
                    android:textColorHint="#BDC3C7"
                    android:textSize="16sp"
                    android:layout_marginBottom="20dp" />

                <!-- Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnClear"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="ล้าง"
                        android:textColor="#7F8C8D"
                        android:backgroundTint="#ECF0F1"
                        android:layout_marginEnd="8dp"
                        app:cornerRadius="10dp" />

                    <Button
                        android:id="@+id/btnSave"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="บันทึก"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#E74C3C"
                        android:layout_marginStart="8dp"
                        app:cornerRadius="10dp" />

                </LinearLayout>

            </LinearLayout>

        <!-- Last Item -->
        <TextView
            android:id="@+id/tvLastItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="รายการล่าสุด: -"
            android:textSize="14sp"
            android:textColor="#7F8C8D"
            android:gravity="center" />

    </LinearLayout>

</ScrollView>
